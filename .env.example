# @pencel/api — Server Configuration
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# External Media Provider Keys (Server-Side Only — never bundle into frontend)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
GIPHY_API_KEY=

# Optional Local PhotoCraft CLI Integration
PHOTOCRAFT_CLI_PATH=
PHOTOCRAFT_TIMEOUT_MS=5000
MAX_IMAGE_BYTES=10485760

# @pencel/web — Frontend Configuration
VITE_API_BASE_URL=/api/v1
VITE_UNSPLASH_APP_NAME=pencelstudio
