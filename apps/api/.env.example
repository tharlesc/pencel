# Pencel API — Example Environment Configuration
# Copy to .env only if you wish to override local defaults.
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Unsplash API Configuration
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
UNSPLASH_SECRET_KEY=your_unsplash_secret_key_here
UNSPLASH_APP_NAME=pencelstudio

# Google Fonts Developer API
GOOGLE_FONTS_API_KEY=your_google_fonts_api_key_here

# GIPHY API Developer Key
GIPHY_API_KEY=your_giphy_api_key_here

# AI Autonomous Generation (Optional: Gemini, Claude, OpenAI or DeepSeek)
# If left blank, Pencel uses user BYOK keys or its built-in Autonomous Design Intelligence engine.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

